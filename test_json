import json
def main():
    data={"name":"jk","age":25,"country":"seoul","city":"delhi","section":"A"}
    with open("data.json","w") as file:
        json.dump(data,file,indent=4)
    assert data["name"] == "jk"
    assert data["age"] == 25
    assert data["country"] =="seoul"
    assert data["city"] =="delhi"
    assert data ["section"] =="A"
if __name__ == "__main__":
        main()